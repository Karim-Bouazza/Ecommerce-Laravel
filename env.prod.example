# Production environment. Copy to .env.prod on the server and fill in.
#
#   cp env.prod.example .env.prod
#
# .env.prod is gitignored and must never be committed. It is consumed twice:
# once by compose itself (for ${DOMAIN} and the mysql credentials) and once by
# the backend container (env_file), which is why application settings and
# infrastructure settings share this file.
#
# URLs (APP_URL, FRONTEND_URLS, SANCTUM_STATEFUL_DOMAINS, SESSION_DOMAIN) and
# the DB_* connection settings are derived from DOMAIN/MYSQL_* directly in
# docker-compose.prod.yml, so they are NOT repeated here — set them there if
# you ever need to override them.

# ---------------------------------------------------------------- domain ----
# Bare domain. nginx serves <DOMAIN> (frontend) and api.<DOMAIN> (backend);
# both need a DNS A record pointing at this server before certificates can be
# issued.
DOMAIN=example.com

# ------------------------------------------------------------------ mysql ---
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
MYSQL_PASSWORD=CHANGE_ME_long_random_password

# --------------------------------------------------------------- runtime ----
APP_NAME=Ecommerce
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Generate with: php artisan key:generate --show
APP_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ------------------------------------------------------------------ mail ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recipient for order-deletion OTP codes.
ORDER_DELETE_OTP_EMAIL=

# ------------------------------------------------------------------ octane --
OCTANE_SERVER=frankenphp
